{
  "name": "pdfparse-sdk",
  "version": "0.1.0",
  "description": "TypeScript SDK for PdfParse document extraction, tables, routing, and workflows.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "homepage": "https://pdfparse.net/docs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PabloG6/pdfparse-integrations.git",
    "directory": "sdk"
  },
  "bugs": {
    "url": "https://github.com/PabloG6/pdfparse-integrations/issues"
  },
  "keywords": [
    "pdf",
    "ocr",
    "extraction",
    "typescript",
    "sdk",
    "pdfparse"
  ],
  "dependencies": {
    "tus-js-client": "^4.3.1"
  },
  "peerDependencies": {
    "@sinclair/typebox": "^0.32.0",
    "valibot": "^1.4.2",
    "yup": "^1.4.0",
    "zod": "^3.25.0"
  },
  "peerDependenciesMeta": {
    "zod": {
      "optional": true
    },
    "valibot": {
      "optional": true
    },
    "yup": {
      "optional": true
    },
    "@sinclair/typebox": {
      "optional": true
    }
  }
}
